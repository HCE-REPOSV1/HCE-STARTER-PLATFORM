
{
  "name": "jarvis-platform-starter",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["jarvis-cli"],
  "scripts": {
    "start": "concurrently --names \"SERVER,UI\" --prefix-colors \"blue,green\" \"npm run server\" \"npm run ui\"",
    "dev": "npm start",
    "server": "npm --prefix jarvis-server run start:dev",
    "ui": "npm --prefix jarvis-ui run dev",
    "install:all": "npm install && npm --prefix jarvis-server install && npm --prefix jarvis-ui install",
    "build": "echo build step placeholder"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
