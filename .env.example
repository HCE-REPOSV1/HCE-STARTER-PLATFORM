# HCE-STARTER-PLATFORM ("Jarvis") — Internal Developer Platform
# que genera microservicios NestJS para HCE_BACK (código + Dockerfile + .env + README).
#
# jarvis-server NO usa dotenv/ConfigModule (no lee un .env por sí solo): estas
# variables solo aplican si las exportás en tu shell antes de "npm run start:dev",
# o si las declarás en docker-compose.yml (ya están seteadas ahí para producción).
#
# jarvis-cli NO usa variables de entorno propias (son solo plantillas que jarvis-server
# escribe dentro de los microservicios generados — ver jarvis-server/src/generator/strategies/*).

# --- jarvis-server (jarvis-server/src/main.ts) ---
# Orígenes permitidos por CORS, separados por coma. Default en código si no se define:
# http://localhost:10201 (main.ts:9). docker-compose.yml lo fija a:
# "http://localhost:10201,http://localhost:5173"
ALLOWED_ORIGINS=http://localhost:10201,http://localhost:5173
# Fijado en jarvis-server/Dockerfile:8 (ENV NODE_ENV=production) para el build de Docker.
# En dev local (npm run start:dev) queda sin definir/"development".
NODE_ENV=development

# --- jarvis-ui (jarvis-ui/Dockerfile, build ARG) ---
# URL del registry npm privado (Verdaccio) usada SOLO en build time para reescribir
# el .npmrc dentro de la imagen Docker (jarvis-ui/Dockerfile:2-9).
# Valor del servidor compartido de referencia: 192.168.42.44:10100
# (en el docker-compose.yml local usa host.docker.internal:10100 vía Docker Desktop).
VERDACCIO_URL=http://192.168.42.44:10100
